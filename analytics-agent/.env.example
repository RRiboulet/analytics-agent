DATABASE_URL=postgresql://olist_readonly:olist_readonly@localhost:5432/olist
ADMIN_DATABASE_URL=postgresql://olist_admin:olist_admin@localhost:5432/olist
MCP_HOST=0.0.0.0
MCP_PORT=8000
QUERY_TIMEOUT_SECONDS=10
MAX_ROWS=100
# Upper bound of the MCP server's PostgreSQL connection pool. Concurrent
# analyst sessions hit the server at once (M8), so keep this at least as
# large as MANAGER_MAX_PARALLELISM.
DB_POOL_MAX_SIZE=10
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
METADATA_SEARCH_TOP_K=5

# ---- Analytics agent (M4) ----

# Streamable HTTP endpoint of the MCP server the agent consumes.
MCP_URL=http://localhost:8000/mcp

# Which LLM backend the agent uses. Two configurations can stay in this file
# simultaneously; LLM_PROVIDER selects the active one.
#
#   llamacpp   — local OpenAI-compatible server (default; LLM_BASE_URL/LLM_MODEL)
#   openrouter — hosted OpenRouter API (requires OPENROUTER_API_KEY below)
LLM_PROVIDER=llamacpp

# --- llama.cpp configuration (active when LLM_PROVIDER=llamacpp) ---

# OpenAI-compatible chat-completions endpoint of the local LLM. Inside the
# devcontainer this points at the HOST model server (host.docker.internal),
# which must listen on a container-reachable interface.
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_MODEL=gemma-4
# Per-call timeout: the local model is slow (CPU, ~1-3 tok/s), so a single
# generation can take minutes. On overrun the agent retries up to
# AGENT_MAX_ATTEMPTS, then reports the error cleanly instead of crashing.
LLM_TIMEOUT_SECONDS=300
# Cap per-generation output tokens (the model runs with --reasoning on, so it
# spends tokens on chain-of-thought before emitting the final SQL/answer).
# Providers bill only what is generated, so a generous cap is free when unused
# and prevents a reasoning pass from exhausting the budget and truncating the
# output to nothing.
LLM_MAX_TOKENS=16384
# Separate cap for the final answer step, still above an observed high-effort
# reasoning pass so the answer prose is never truncated away.
LLM_ANSWER_MAX_TOKENS=8192
# Max regeneration attempts before the agent fails (no infinite loops).
AGENT_MAX_ATTEMPTS=3

# Thinking level for OpenAI-compatible reasoning models: low | medium | high |
# max. Unset (default) sends no reasoning parameter at all, which is what the
# local llama.cpp path wants (it is configured with --reasoning on instead).
# Reasoning tokens count against LLM_MAX_TOKENS / LLM_ANSWER_MAX_TOKENS, so a
# reasoning model needs headroom above its thinking budget: on
# deepseek-v4.1-flash with effort=high a single call spends ~400-600 reasoning
# tokens before any answer text, and a hard question several thousand. The
# defaults above (16384 / 8192) leave room for that; the old 512-token answer
# cap truncated such calls to an empty completion.
# LLM_REASONING_EFFORT=

# --- OpenRouter configuration (active when LLM_PROVIDER=openrouter) ---

# API key from https://openrouter.ai/keys (secret; keep out of version control).
# OPENROUTER_API_KEY=
# OpenRouter model id (see https://openrouter.ai/models).
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Override only if OpenRouter changes its API endpoint.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_TIMEOUT_SECONDS / LLM_MAX_TOKENS / LLM_ANSWER_MAX_TOKENS above apply to
# OpenRouter too; a hosted model is much faster, so a shorter timeout is safe.

# --- OpenCode configuration (active when LLM_PROVIDER=opencode) ---

# API key for OpenCode Go (secret; keep out of version control).
# OPENCODE_API_KEY=
# OpenCode model id. Reasoning-capable ids on this key report their supported
# effort levels under capabilities.reasoning.effort
# (GET $OPENCODE_BASE_URL/models): e.g. "deepseek-v4.1-flash" supports
# low/high/max, so pair it with LLM_REASONING_EFFORT=high.
# OPENCODE_MODEL=deepseek-v4.1-flash
# Override only if OpenCode changes its API endpoint.
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# LLM_TIMEOUT_SECONDS / LLM_MAX_TOKENS / LLM_ANSWER_MAX_TOKENS above apply to
# OpenCode too; a hosted model is much faster, so a shorter timeout is safe.

# --- Analytics manager (M7/M8) ---

# Bounded parallelism for the manager's analyst fan-out: the decomposition's
# sub-questions (at most 4) and the single follow-up round run as concurrent
# analyst runs under a semaphore of this size. 1 restores sequential runs.
MANAGER_MAX_PARALLELISM=4

# --- Web surface (M8) ---

# The run page and its streaming endpoint. Loopback by default: this surface is
# for this host, whose policy is that SSH is its only open port. Port 8001
# avoids the MCP server's 8000.
WEB_HOST=127.0.0.1
WEB_PORT=8001
# Process-wide cap on concurrent runs (default 2). A visitor beyond the cap is
# not rejected: the page shows an explicit queued state and the run starts when
# a slot frees. Each run is a whole manager run (up to MANAGER_MAX_PARALLELISM
# concurrent analyst runs), so keep this in line with what the model provider
# and the database pool can serve; 1 serializes runs.
WEB_MAX_CONCURRENT_RUNS=2
# Optional shared token for the run endpoint; unset disables the check. When
# set, open the page with ?token=<value> (it forwards the X-Web-Token header)
# or pass the header / ?token= query parameter yourself. Never a database or
# model credential.
# WEB_TOKEN=

# --- Langfuse tracing (optional, fail-open). Uncomment to enable. ---
# Both keys are required (LANGFUSE_HOST defaults to the Langfuse cloud, or set
# it to your self-hosted instance). One trace per agent run captures nodes,
# LLM calls, MCP tool calls, retries and the final answer.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=