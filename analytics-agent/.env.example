DATABASE_URL=postgresql://olist_readonly:olist_readonly@localhost:5432/olist
ADMIN_DATABASE_URL=postgresql://olist_admin:olist_admin@localhost:5432/olist
MCP_HOST=0.0.0.0
MCP_PORT=8000
QUERY_TIMEOUT_SECONDS=10
MAX_ROWS=100
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
METADATA_SEARCH_TOP_K=5

# ---- Analytics agent (M4) ----

# Streamable HTTP endpoint of the MCP server the agent consumes.
MCP_URL=http://localhost:8000/mcp

# Which LLM backend the agent uses. Two configurations can stay in this file
# simultaneously; LLM_PROVIDER selects the active one.
#
#   llamacpp   — local OpenAI-compatible server (default; LLM_BASE_URL/LLM_MODEL)
#   openrouter — hosted OpenRouter API (requires OPENROUTER_API_KEY below)
LLM_PROVIDER=llamacpp

# --- llama.cpp configuration (active when LLM_PROVIDER=llamacpp) ---

# OpenAI-compatible chat-completions endpoint of the local LLM. Inside the
# devcontainer this points at the HOST model server (host.docker.internal),
# which must listen on a container-reachable interface.
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_MODEL=gemma-4
# Per-call timeout: the local model is slow (CPU, ~1-3 tok/s), so a single
# generation can take minutes. On overrun the agent retries up to
# AGENT_MAX_ATTEMPTS, then reports the error cleanly instead of crashing.
LLM_TIMEOUT_SECONDS=300
# Cap per-generation output tokens (the model runs with --reasoning on, so it
# spends tokens on chain-of-thought before emitting the final SQL/answer).
LLM_MAX_TOKENS=4096
# Separate, tighter cap for the final answer step so the reasoning model cannot
# spend its whole budget on chain-of-thought before the answer.
LLM_ANSWER_MAX_TOKENS=512
# Max regeneration attempts before the agent fails (no infinite loops).
AGENT_MAX_ATTEMPTS=3

# --- OpenRouter configuration (active when LLM_PROVIDER=openrouter) ---

# API key from https://openrouter.ai/keys (secret; keep out of version control).
# OPENROUTER_API_KEY=
# OpenRouter model id (see https://openrouter.ai/models).
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Override only if OpenRouter changes its API endpoint.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_TIMEOUT_SECONDS / LLM_MAX_TOKENS / LLM_ANSWER_MAX_TOKENS above apply to
# OpenRouter too; a hosted model is much faster, so a shorter timeout is safe.

# --- Langfuse tracing (optional, fail-open). Uncomment to enable. ---
# Both keys are required (LANGFUSE_HOST defaults to the Langfuse cloud, or set
# it to your self-hosted instance). One trace per agent run captures nodes,
# LLM calls, MCP tool calls, retries and the final answer.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=