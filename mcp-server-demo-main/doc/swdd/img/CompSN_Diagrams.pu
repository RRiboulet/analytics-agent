' Data Structure Diagrams
'------------------------------------------------------------------------------------------------

@startuml SwComponentClassDiagram1.svg


class SwComp_BaseClass {
}

class SwComp_ErrorManager{
+SwComp_ErrorManager()
+\~SwComp_ErrorManager()
}

class SwComp_Class{
+SwComp_u_MemberFunction()
+r_GetInst()
+u_ConstantValue
-SwComp_Class()
-\~SwComp_Class()
}

SwComp_BaseClass <|-- SwComp_ErrorManager
SwComp_BaseClass <|-- SwComp_Class

@enduml

'################################################################################################
'State Diagrams
'################################################################################################

@startuml "UnitA_OpX_StateDiag.svg"

state SYS_PROCESS {
  State BASE_OM_COMPONENT_PROCESS {
  }

  [*] -down-> BASE_OM_RESET
  BASE_OM_RESET -down-> BASE_OM_COMPONENT_PROCESS : give condition for state change
  BASE_OM_COMPONENT_PROCESS -down-> BASE_OM_COMPONENT_PROCESS_FINAL : give condition for state change
  BASE_OM_COMPONENT_PROCESS -up-> BASE_OM_RESET : give condition for state change
  BASE_OM_COMPONENT_PROCESS_FINAL -up-> BASE_OM_COMPONENT_PROCESS : give condition for state change
  BASE_OM_COMPONENT_PROCESS_FINAL -up-> BASE_OM_RESET : give condition for state change

  ' Note for status BASE_OM_RESET
  note left of BASE_OM_RESET
  sets SRC_COMPONENT to a 
  predefined state
  end note

  ' Note for status BASE_OM_COMPONENT_PROCESS
  note left of BASE_OM_COMPONENT_PROCESS
  actions of this operation mode
  end note

  ' Note for status BASE_OM_COMPONENT_PROCESS_FINAL 
  note left of BASE_OM_COMPONENT_PROCESS_FINAL 
  next operations
  end note
}

[*] -right-> SYS_PROCESS

@enduml
