@startuml OverallSequenceDiagramExample.svg

activate SwUnit_1
SwUnit_1 -> SwUnit_2: Init() calls SetCalibrationData()
deactivate SwUnit_1

alt if param1 != NULL && param2 != NULL
activate SwUnit_2
SwUnit_2 -->> SwUnit_1: result(ok)
else else if HW != available
SwUnit_2 -> SwUnit_2: SendHardwareError()
SwUnit_2 -->> SwUnit_1: result(nok)
rnote over SwUnit_1: hwErrorOccured
else else
SwUnit_2 -> SwUnit_2: SendError()
SwUnit_2 -->> SwUnit_1: result(nok)
deactivate SwUnit_2
activate SwUnit_1
rnote over SwUnit_1: errorOccured
end

loop while != errorOccured
SwUnit_1 -> SwUnit_2: Main()
deactivate SwUnit_1

activate SwUnit_2
SwUnit_2 -->> SwUnit_1: result
deactivate SwUnit_2
end

opt if errorOccured
activate SwUnit_1
SwUnit_1 -> SwUnit_4: callErrorHdl(errorId)
deactivate SwUnit_1
activate SwUnit_4
rnote over SwUnit_4: errorFlag = errorId
SwUnit_4 -->> SwUnit_3: errorFlag
SwUnit_4 -->> SwUnit_1: return
deactivate SwUnit_4
activate SwUnit_1
end

@enduml
'------------------------------------------------------------------------------------------------

@startuml SequenceDiagramExample.svg

legend center
**Legend of diagram:**  Text of the legend, aligned in the center of the diagram.
endlegend

opt if 1=1
activate SwUnit_3
SwUnit_3 -> SwDD_Template_SrcC: FunctionX() calls SwDD_Template_u_InterfaceFunc1()
deactivate SwUnit_3
activate SwDD_Template_SrcC
alt param1 != NULL && param2 != NULL
SwDD_Template_SrcC -> SwUnit_1: FunctionA(param1)
deactivate SwDD_Template_SrcC
activate SwUnit_1
SwUnit_1 -->> SwDD_Template_SrcC: result
deactivate SwUnit_1
activate SwDD_Template_SrcC
SwDD_Template_SrcC -> SwUnit_1: FunctionB(param2)
deactivate SwDD_Template_SrcC
activate SwUnit_1
SwUnit_1 -->> SwDD_Template_SrcC: result
deactivate SwUnit_1
activate SwDD_Template_SrcC
else else
loop 100 times
SwDD_Template_SrcC -> SwDD_Template_SrcC: FunctionC()
SwDD_Template_SrcC -->> SwDD_Template_SrcC: result
end
end
rnote over SwDD_Template_SrcC: u_DummyflagX = 0
SwDD_Template_SrcC -->> SwUnit_3: result
deactivate SwDD_Template_SrcC
activate SwUnit_3
end

@enduml
