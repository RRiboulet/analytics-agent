'------------------------------------------------------------------------------------------------
'SW Component Decomposition Diagram
'------------------------------------------------------------------------------------------------
@startuml SwComponentDecomposition.svg
!define sw_component(comp_name) component comp_name <<sw_component>>
!define sw_unit(unit_name) class unit_name << (U,#FF7700) sw_unit >>

sw_component(CompSN){
   sw_unit(UnitA)
   sw_unit(UnitB)
   sw_unit(UnitC)
}
@enduml

'------------------------------------------------------------------------------------------------
'SW Component Diagram - Required and Provided IFs
'------------------------------------------------------------------------------------------------

@startuml SwComponentDiagram.svg
!define sw_component(comp_name) component comp_name <<sw_component>>
!define sw_unit(unit_name) class unit_name << (U,#FF7700) sw_unit >>
!define provided_if(if_name) interface if_name <<provided_if>>
!define required_if(if_name) interface if_name <<required_if>>
!define function(fct_name) +fct_name()
!define variable(var_name) +var_name

sw_component(CompSN){
   sw_unit(UnitA)
   sw_unit(UnitB)
   sw_unit(UnitC)
}

sw_component(OS){

interface OS_IFs <<Required_IFs>>{
   function(OS_InitSp)
   function(OS_InitCsaList)
   variable(OS_INITIAL_PSW)
   }
}
OS_IFs -d-> UnitA


sw_component(RamInit){
interface RamInit_IFs <<Required_IFs>>{
   function(RamInit_Global)
   }
}
RamInit_IFs -d-> UnitB

sw_component(MCAL){
interface MCAL_IFs <<Required_IFs>>{
   function(Mcal_GetCpuIndex)
   }
}
MCAL_IFs -d-> UnitB

sw_component(MPU){
interface MPU_IFs <<Required_IFs>>{
   function(Mpu_Init)
   function(Mpu_Activate)
   function(Mpu_DeActivate)
   function(Mpu_GetDataProtection)
   }
}
MPU_IFs -d-> UnitB

interface Scheduling <<Provided_IFs>> {
   function(Startup_Init)
}
UnitB -d-> Scheduling
@enduml


'------------------------------------------------------------------------------------------------
' File Include Structure Diagram
'------------------------------------------------------------------------------------------------

@startuml SwComponentFileStructure.svg
!define sw_component(comp_name) component comp_name <<sw_component>>
sw_component(CompSN){

file "CompSN.h" as comp_header_file
file "CompSN_rif.h" as comp_rif_file
file "CompSN_pif.h" as comp_pif_file


file "CompSN_Cfg.h" as comp_cfg_header_file
file "CompSN_Cfg.c" as comp_cfg_source_file


file "UnitA.c" as unit_a_src_file
file "UnitB.c" as unit_b_src_file
file "UnitB.h" as unit_b_header_file
file "UnitC.c" as unit_c_src_file
file "UnitC.h" as unit_c_header_file
}
file "Base Types & \nOther SWC PIF Files" as comp_include_files
comp_include_files --[hidden] comp_pif_file

comp_rif_file -right-> comp_include_files: <<includes>>
comp_rif_file -right-> comp_pif_file: <<includes>>
comp_header_file -right-> comp_rif_file: <<includes>> 
comp_header_file -left-> comp_cfg_header_file: <<includes>> 

comp_cfg_source_file -up-> comp_header_file: <<includes>>

unit_a_src_file -up-> comp_header_file: <<includes>>

unit_b_src_file -up-> unit_b_header_file: <<includes>>
unit_b_header_file -up-> comp_header_file: <<includes>>

unit_c_src_file -up-> unit_c_header_file: <<includes>>
unit_c_header_file -up-> comp_header_file: <<includes>>

@enduml

