'################################################################################################
'Sequence Diagrams
'################################################################################################

@startuml UnitA_OpY_SequenceDiag.svg
participant "Startup\n SchedulingIF\n Actor" as Startup_SchedulingIF_Actor
participant "Startup\n DataIF\n Actor" as Startup_DataIF_Actor



box #LightBlue
participant "Startup"
end box


Startup_SchedulingIF_Actor -> Startup: boot/bootAlt -> Startup_Init()
note right: boot/bootAlt are assembly symbols that trigger Startup_Init function

Startup -> MCAL: Mcal_GetCpuIndex()
MCAL --> Startup: CoreId = MasterCore

Startup -> MCU: Read Register SCU_RSTSTAT
MCU --> Startup: Return ResetType = WAKEUP_RESET

Startup -> MCU: Read Register PMS_PMSWSTAT2
MCU --> Startup: Return ResetSource

Startup -> MCU: Write Register PMS_PMSWSTATCLR
note right: Clear the reset source information after reading
MCU --> Startup: 


Startup --> Startup_SchedulingIF_Actor

Startup_DataIF_Actor -> Startup: Startup_GetResetReason()
Startup --> Startup_DataIF_Actor: Startup_ResetReasonType = STARTUP_WAKEUP_RESET

Startup_DataIF_Actor -> Startup: Startup_GetResetSource()
Startup --> Startup_DataIF_Actor: Startup_ResetSourceType
@enduml

'------------------------------------------------------------------------------------------------

