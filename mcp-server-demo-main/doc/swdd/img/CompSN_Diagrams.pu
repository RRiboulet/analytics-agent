@startuml "Class_Example.svg"

component CompSN {

class SwComp_BaseClass {
}

class SwComp_ErrorManager{
+SwComp_ErrorManager()
+\~SwComp_ErrorManager()
}

class SwComp_Class{
+SwComp_u_MemberFunction()
+r_GetInst()
+u_ConstantValue
-SwComp_Class()
-\~SwComp_Class()
}

SwComp_BaseClass <|-- SwComp_ErrorManager
SwComp_BaseClass <|-- SwComp_Class
}
@enduml
'------------------------------------------------------------------------------------------------
@startuml "Usecase_Example.svg"
"SW Unit Verification" as SwU
"SW Integration" as SwI

SwU --> (Create SW Unit Tests)
SwU --> (Execute SW Unit Tests)
SwU -right-> (Read SW Detailed Design) : Internal SW

"Execute Integration Test (White Box)" as (WhiteBox)

SwI -left-> (Read SW Detailed Design) : Internal SW
SwI --> (Read Integration Manual) : Internal SW
SwI -right-> (Integrate Sw Component) : Internal SW
SwI --> (WhiteBox)
SwI --> (Configure the SW Component)
@enduml
'------------------------------------------------------------------------------------------------
@startuml "ComponentDesign_ExampleTwo.svg"
skinparam componentStyle uml2
skinparam DefaultTextAlignment center

package "SwIsrs"{
	component "SwUnit 5\n--\n\n <i>Interrupt</i>\n SwDD_Template_ISR" as U5
}

() "<i><size:12>IfcFunc3_1</size>" as IF1_1

package "SwDD_Template"{

component U1 [
SwUnit 3
--
<i>configuration data</i>
SwDD_Template_t_Data1 
]

[SwUnit 2] as U2
[SwUnit 4] as U3
[SwUnit 1] as U4

() "<size:12>IfcFunc2_1</size>" as IF2_1
() "<size:12>IfcFunc4_1</size>" as IF3_1
() "<size:12>IfcFunc1_1</size>" as IF4_1
() "<size:12>IfcFunc1_2</size>" as IF4_2

U1 #-right-( IF1_1: "<i><size:10>provided interface</size></i>"
U2 #--( IF2_1: "<i><size:10>provided interface</size></i>"
U3 #-left-( IF3_1: "<i><size:10>provided interface</size></i>"
U4 #--( IF4_1: "<i><size:10>provided interface</size></i>"
U4 #--( IF4_2: "<i><size:10>provided interface</size></i>"

U1 <.left. IF2_1 : "<i><size:10>use</size></i>"
U1 ..> IF3_1 : "<i><size:10>use</size></i>"
U2 ..> IF4_1 : "<i><size:10>use</size></i>"
U3 ..> IF4_2 : "<i><size:10>use</size></i>"
} 

U5 ..> IF1_1 : "<i><size:10>use</size></i>"

@enduml
