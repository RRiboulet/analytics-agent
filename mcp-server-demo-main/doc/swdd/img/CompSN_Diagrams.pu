@startuml "ComponentDiagram_Example.svg"
skinparam componentStyle uml2
[SwDD_Template] as SRC
() "xxx_Cfg" as Port1
() "yyy_ScheduleCfg" as Port2
() "SwDD_Template_Ifc1" as Port3
() "SwDD_Template_Ifc2" as Port4
() "SwDD_Template_Ifc3" as Port5
SRC #-down- Port3: provide
SRC #-down- Port4: provide
SRC #-down- Port5: provide
SRC #-down-( Port1 : require
SRC #-down-( Port2 : require
legend
Required port: part of the SwDD_Template input parameters.
====
Provided port: part of the SwDD_Template output parameters.
end legend
@enduml
