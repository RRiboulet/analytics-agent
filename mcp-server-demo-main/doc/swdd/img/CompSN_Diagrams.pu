'------------------------------------------------------------------------------------------------
'Timing Diagrams
'------------------------------------------------------------------------------------------------
@startuml TimingDiagramOption1.svg
concise "Micro Kernel" as MK
concise "Startup C" as SC
concise "Startup Assembly" as SA
concise "Device State" as DS
binary "Reset Event" as RE


@0
DS is "Defined"
RE is 0
SA is "Inactive"
MK is "Active"

@10
DS is "Unknown"
RE is 1
MK is "Inactive"

@10.1
SA is "Active"


@11
RE is 0
SA is "Init Device"


@20
DS is "Defined"


@20.1
MK is "Active"
SA is Inactive

SA -> MK: Trigger Mikro Kernel
@enduml

