@startuml "ComponentDesign_Example.svg"  
skinparam componentStyle uml2
skinparam DefaultTextAlignment center

' create package external interfaces
' so create them outside of package
() "<size:12>IfcFunc1_1</size>" as IF1_1
() "<size:12>IfcFunc1_2</size>" as IF1_2
() "<size:12>CompExec</size>" as IF4_1

' create SwComp package
package "SwComp"{
' create units 1, 2 and 4
' units should be in one line, so add in together
together {
[SwUnit 2] as U2
[SwUnit 1] as U1
[SwUnit 4] as U4
}

' create package internal interface
' so add it in the package
() "<size:12>IfcFunc2_1</size>" as IF2_1

' create units 3 and 5
' units should be in one line, so add in together
together {
'create SwUnit3 with line break notation
component U3 [
  SwUnit 3
  --
  <i>configuration data</i>
  SwComp_t_Data1 
]
'create SwUnit5 within one line, but similar information then SWUnit 3
component "SwUnit 5\n--\n\n <i>Interrupt</i>\n SwComp_ISR" as U5
}

' create connections
U1 #-right( IF1_1: "<i><size:10>provided interface</size></i>"
U1 #-down-( IF1_2: "<i><size:10>provided interface</size></i>"

U2 #-down-( IF2_1: "<i><size:10>provided interface</size></i>"
U2 ..> IF1_2: "<i><size:10>use</size></i>"

U3 <.up. IF2_1: "<i><size:10>use</size></i>"

U4 #-left( IF4_1: "<i><size:10>provided interface</size></i>"
U4 ..> IF2_1: "<i><size:10>use</size></i>"

U5 .right.> U3: "<i><size:10>use</size></i>"
} 
@enduml
'------------------------------------------------------------------------------------------------

