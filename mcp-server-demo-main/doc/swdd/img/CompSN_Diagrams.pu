   variable(INITIAL_A0)
   variable(INITIAL_A1)
   variable(INITIAL_A8)
   function(Entry2)
   function(X_InterruptTable)
   function(X_kernelStackTop)
   function(WriteEndinit)
   function(Startup)
   }
}
