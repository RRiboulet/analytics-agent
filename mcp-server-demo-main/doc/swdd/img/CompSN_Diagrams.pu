@startuml "ObjectDiagram.svg"
object ImageData {
	name = "ImageData"
}
object ImageBuffer {
	name = "ImageBuffer"
	type = "Pointer"
	Unit = "-"
	Resolution = "-"
	Offset = "-"
	Data range = "-"
}
object Height {
	name = "ImageHeigth"
	type = "uint32"
	Unit = "pixel"
	Resolution = "1:2"
	Offset = "0"
	Data range = "0-2048"
}
object Width {
	name = "ImageWidth"
	type = "uint32"
	Unit = "pixel"
	Resolution = "1:1"
	Offset = "0"
	Data range = "0-512"
}

ImageData "1" *-- "1" ImageBuffer
ImageData "1" <|-- "1" Height
ImageData "1" o-- "1" Width

@enduml
