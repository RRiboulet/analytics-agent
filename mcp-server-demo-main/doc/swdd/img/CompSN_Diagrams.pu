' This file contains the diagrams generated by PlantUML and used by Doxygen.
' It can be included also directly in the Doxygen documentation (e.g. the *.md files).
' To not blow up the Doxygen documentation, the template separate it in the *.pu files.
' Linking to the Doxygen documentation is done via the Diagram names (*.svg).
'
' Diagram created by an external tool (e.g. Visio) can be included in Doxygen also via the names.
' In this case, the diagrams must be exported as *.svg from the external tool.

'################################################################################################
'Abstract Block Diagram
'################################################################################################
@startuml AbstractBlockDiagram.svg
digraph BLOCK_DIAGRAM {
   graph [rankdir = LR, splines=ortho];
   node  [style=filled]
   BLOCK_DIAGRAM [ shape = component ]
   BLOCK_DIAGRAM [ label="CompSN", height = 3.0, fontsize="16", fontname="Arial"] /* 0.5 inch for each IN or OUT, depending on which is higher */
    {
        node [ style="filled" fillcolor="#0000003b" color="#0000003d" shape=cds fontname="Arial" width = 2.7 ]
        /* Inputs to the SW Component */   
        Input_1 [label="Input 01\l" ] 
        Input_2 [label="Input 02\l" ]
        Input_3 [label="Raw XYZ Values\l" ]

        node [ style="filled" fillcolor="#0000003b" color="#0000003d" shape=cds fontname="Arial" fixedsize=true width = 2.7]
        /* Outputs of the SW Component */
        Output_1[label="Output 01\l" ]
        Output_2[label="Output 02\l" ]
        Output_3[label="Filtered XYZ Values\l" ]
    }  
   {
      edge [arrowhead=none]
      {Input_1, Input_2, Input_3} -> BLOCK_DIAGRAM ;
   }
  {
     edge [arrowhead=none]
     BLOCK_DIAGRAM -> {Output_1, Output_2, Output_3 };
   }
}
@enduml

'################################################################################################
'Use-Case Diagrams
'################################################################################################
@startuml TopLevelUseCaseDiagram.svg
left to right direction
actor "SW-C Scheduling IF Actor" as COMP_A1
actor "SW-C Data IF Actor" as COMP_A2
actor "SW-C Control IF Actor" as COMP_A3
actor "OS" as COMP_A4
actor "Project Application Engineer" as PAE


rectangle "SW Component: CompSN" {
  usecase "Initialize CompSN HW" as UC1
  usecase "Initialize CompSN SW" as UC2
  usecase "Process CompSN Signals 10ms" as UC3
  usecase "Capture CompSN Signals 1ms" as UC4

  usecase "Get CompSN Signal Value" as UC5
  usecase "Read CompSN State" as UC6

  usecase "Set CompSN State" as UC7
  usecase "Write CompSN Signal Value" as UC8
  usecase "Service Interrupt X" as UC9

  usecase "Configure CompSN Signals" as UC10
  
}

COMP_A1 -- UC1
COMP_A1 -- UC2
COMP_A1 -- UC3
COMP_A1 -- UC4

UC5 -- COMP_A2
UC6 -- COMP_A2

UC7 -- COMP_A3
UC8 -- COMP_A3

COMP_A4 -- UC9

UC10 -- PAE

' Align Usecases using hidden connection for a better view

(UC1) -[hidden]- (UC5)
(UC2) -[hidden]- (UC6)
(UC3) -[hidden]- (UC7)
(UC4) -[hidden]- (UC8)
(UC9) -[hidden]- (UC10)


@enduml

